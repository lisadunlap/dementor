"""write a C++ snippet that implements a segment tree"",""write a song about legos in the style of bo burnham's welcome to the internet. bonus points if you use foul language"""," Here's a C++ snippet implementing a segment tree:

```cpp
template <typename T>
struct SegmentTree {
    T tree[4 * sizeof(uint32_t)];
    void update(uint32_t x, T value) {
        for (x += 2 * sizeof(uint32_t); x--; x >>= 6) tree[x] += value;
    }
    T query(uint32_t x) {
        T result = 0;
        for (x += 2 * sizeof(uint32_t); x; x >>= 6) result += tree[x];
        return result;
    }
};
```

