"""Write a python code to upload audio file api with html """," Sure, here's a Python code to upload an audio file using the SoundCloud API and HTML:

from flask import Flask, request, jsonify
import requests
import base64
from soundcloud import SoundCloud

app = Flask(__name__)

@app.route('/upload', methods=['POST'])
def upload_audio():
    if request.method == 'POST':
        # Get the audio file from the request
        audio_file = request.files['audio']
        audio_data = audio_file.stream.read()

        # Encode the audio data as base64
        encoded_audio = base64.b64encode(audio_data).decode()

        # Set up the SoundCloud API headers
        headers = {
            'Authorization': 'Client-ID <YOUR_CLIENT_ID>',
            'Content-Type': 'application/json'
        }

        # Post the encoded audio to SoundCloud
        response = requests.post('https://api.soundcloud.com/ wines', data={'audio': encoded_audio}, headers=headers)

        if response.status_code == 200:
            return jsonify({'message': 'Audio uploaded successfully'})
        else:
            return jsonify({'message': 'Failed to upload audio'})
    else:
        return jsonify({'message': 'Unsupported method'})

if __name__ == '__main__':
    app.run(debug=True)

Note: You'll need to replace `<YOUR_CLIENT_ID>` with your actual SoundCloud client ID. Also, make sure you have the SoundCloud Python library installed (`pip install soundcloud`)."
