Sub CompareSheets()
 Dim wb1 As Workbook, wb2 As Workbook, wb3 As Workbook
 Dim ws1 As Worksheet, ws2 As Worksheet, ws3 As Worksheet
 Dim i As Integer, j As Integer
 Dim cell1 As Range, cell2 As Range, cell3 As Range

 Set wb1 = Worksheets(1).Sheets(""Sheet1"")
 Set wb2 = Worksheets(2).Sheets(""Sheet1"")
 Set wb3 = Worksheets(3).Sheets(""Sheet1"")

 For i = 1 To 100 'Change this to the number of columns you want to compare
 For j = 1 To 100 'Change this to the number of rows you want to compare
 cell1 = wb1.Cells(i, j)
 cell2 = wb2.Cells(j, i)
 cell3 = wb3.Cells(j, i)

 If cell1.Value <> cell2.Value Or cell1.Value <> cell3.Value Then
   'You can add your code here to handle the differences
   'For example, you might want to close the workbook or display a message
 End If
Next j
Next i
End Sub

```

