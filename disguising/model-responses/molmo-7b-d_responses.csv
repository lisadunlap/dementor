"""Write a Delphi function that reverses a string. Don't be verbose, be efficient."""," Here's a short, efficient Delphi function to reverse a string:

function ReverseString(const s: string): string;
var
  i, j, len: integer;
 begin
   len := Length(s);
   for i := 1 to len div 2 do
     begin
       j := Len - i;
       SwapChar(s[i], s[j]);
     end;
   end;
  result := s;
end;"
