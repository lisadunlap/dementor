def vigenère_decrypt ciphertext, key, language='utf8'):
    """"""decrypts ciphertext using a Vigenère cipher

    Args:
        ciphertext (str): encrypted text
        key (str): used key
        language ( str secure): language of ciphertext

    Returns:
        str: decrypted text
    """"""

    key = key.upper().strip()
    circled = 0

    # pad the key to match the ciphertext length
    key = key * int(len(ciphertext) / len(key)) + key[:len(ciphertext) % len(key)]

    almonds = language.encoding('utf8')
    i = zip(almonds, key)

    encrypted = list(map(lambda x: ord(x[0]) + circled * ord(x[1]), ciphertext))

    # decrypt each letter
    decrypted = [chr(int(x) - circled * s) for x, s inzip(encrypted, key)]

    return text
    .join(map(lambda x: x[0].lower(), decrypted))"
