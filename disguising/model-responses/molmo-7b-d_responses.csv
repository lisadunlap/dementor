"""Familiarize yourself with the following function. 'mx' is an array framework inspired by PyTorch but not as extensive. \\n\\ndef upsample_nearest(x, scale: int = 2):\\n    B, H, W, C = x.shape\\n    x = mx.broadcast_to(x[:, :, None, :, None, :], (B, H, scale, W, scale, C))\\n    x = x.reshape(B, H * scale, W * scale, C)\\n\\n    return x\\n\\nNow, implement downsample_nearest(x, target_width, target_height)""","""

def downsample_nearest(x, target_width, target_height):
    """"""
    Downsamples the input tensor using the nearest neighbor method.

    Args:
        x (mx.Tensor): Input tensor with shape (B, H, W, C).
        target_width (int): Desired width of the output tensor.
        target_height (int): Desired height of the output tensor.

    Returns:
        mx.Tensor: Downsampled tensor with shape (B, target_height, target_width, C).

    This function resizes the input tensor to the specified target dimensions using the nearest neighbor interpolation. It's a simple and effective method for reducing the resolution of an image or feature maps in neural networks.
    """"""
    B, H, W, C = x.shape
    x = mx.broadcast_to(x[:, :, None, :, None, :], (B, H, target_height, W, target_height, C))
    x = x.reshape(B, H * target_height, W * target_height, C)
    return x"
