"""\\u6539\\u8fdb\\u4e00\\u4e0b\\u7684\\u90e8\\u5206\\u4ee3\\u7801\\uff0c\\u5b9e\\u73b0\\u4e0d\\u540c\\u7fa4\\u7ec4\\u4e4b\\u95f4\\u7684\\u6d88\\u606f\\u8f6c\\u53d1\\uff1aconst koishi = require('koishi-core');\\nconst { Random } = require('koishi-utils');\\nconst database = require('your-database-module'); \\/\\/ \\u4f60\\u7684\\u6570\\u636e\\u5e93\\u6a21\\u5757\\n\\nkoishi.plugin('murder-mystery', (ctx) => {\\n  let sessions = {};\\n\\n  function getSession(sessionId) {\\n    if (!sessions[sessionId]) {\\n      sessions[sessionId] = new Session(sessionId);\\n    }\\n    return sessions[sessionId];\\n  }\\n\\n  class Session {\\n    sessionId: any;\\n    players: any[];\\n    murderer: null;\\n    victim: null;\\n    votes: any[];\\n    turns: number;\\n    constructor(sessionId) {\\n      this.sessionId = sessionId;\\n      this.players = [];\\n      this.murderer = null;\\n      this.victim = null;\\n      this.votes = [];\\n      this.turns = 2;\\n    }\\n    \\n\\n    getStatus() {\\n      return `\\u5f53\\u524d\\u56de\\u5408\\uff1a${this.turns}\\\\n\\u5df2\\u52a0\\u5165\\u73a9\\u5bb6\\uff1a${this.players.join(', ')}\\\\n\\u5df2\\u6295\\u7968\\u4eba\\u6570\\uff1a${this.votes.length}`;\\n    }\\n  \\n    sendMessage(playerId, message) {\\n      if (!this.players.includes(playerId)) {\\n        throw new Error('\\u4f60\\u8fd8\\u6ca1\\u6709\\u52a0\\u5165\\u6e38\\u620f\\uff01');\\n      }\\n      this.broadcast(`${playerId}\\uff1a${message}`);\\n    }\\n\\n\\n    addPlayer(playerId) {\\n      if (this.players.length >= 6) {\\n        throw new Error('\\u6e38\\u620f\\u4eba\\u6570\\u5df2\\u6ee1\\uff01');\\n      }\\n      this.players.push(playerId);\\n    }\\n    start() {\\n      if (this.players.length < 6) {\\n        throw new Error('\\u6e38\\u620f\\u4eba\\u6570\\u4e0d\\u8db3\\uff0c\\u65e0\\u6cd5\\u5f00\\u59cb\\uff01');\\n      }\\n      this.murderer = Random.pick(this.players);\\n      this.victim = Random.pick(this.players.filter(p => p !== this.murderer));\\n      this.broadcast('\\u6e38\\u620f\\u5f00\\u59cb! \\u4e94\\u4f4d\\u5acc\\u7591\\u4eba\\u548c\\u4e00\\u4e2a\\u88ab\\u5bb3\\u4eba\\u5df2\\u7ecf\\u786e\\u5b9a.');\\n    }\\n    vote(playerId, suspectId) {\\n      if (!this.players.includes(playerId)) {\\n        throw new Error('\\u4f60\\u8fd8\\u6ca1\\u6709\\u52a0\\u5165\\u6e38\\u620f\\uff01');\\n      }\\n      if (!this.players.includes(suspectId)) {\\n        throw new Error('\\u6295\\u7968\\u7684\\u5bf9\\u8c61\\u4e0d\\u5728\\u6e38\\u620f\\u4e2d\\uff01');\\n      }\\n      this.votes.push({ playerId, suspectId });\\n      if (this.votes.length === this.players.length) {\\n        this.endTurn();\\n      }\\n    }\\n\\n\\n    \\n\\n    endTurn() {\\n      const votes = this.votes.reduce((acc, vote) => {\\n        acc[vote.suspectId] = (acc[vote.suspectId] || 0) + 1;\\n        return acc;\\n      }, {});\\n      const maxVotes = Math.max(...Object.values(votes));\\n      const mostVoted = Object.keys(votes).filter(id => votes[id] === maxVotes);\\n      if (mostVoted.includes(this.murderer)) {\\n        this.broadcast('\\u771f\\u51f6\\u88ab\\u63a8\\u65ad\\u51fa\\u6765\\u4e86! \\u5176\\u4f59\\u73a9\\u5bb6\\u83b7\\u80dc!');\\n      } else if (--this.turns) {\\n        this.broadcast('\\u771f\\u51f6\\u8fd8\\u5728\\u900d\\u9065\\u6cd5\\u5916! \\u4e0b\\u4e00\\u56de\\u5408\\u5f00\\u59cb.');\\n      } else {\\n        this.broadcast('\\u771f\\u51f6\\u900d\\u9065\\u6cd5\\u5916! \\u771f\\u51f6\\u83b7\\u80dc!');\\n      }\\n    }\\n\\n    broadcast(message) {\\n      ctx.sender.sendGroup(this.sessionId, message);\\n    }\\n  }\\n\\n  ctx.command('murder-mystery.join', '\\u52a0\\u5165\\u6e38\\u620f')\\n    .channelFields(['murder-mystery.sessionId'])\\n    .action(({ session }) => {\\n      const game = getSession(session.channel['murder-mystery.sessionId']);\\n      try {\\n        game.addPlayer(session.userId);\\n        return '\\u4f60\\u5df2\\u7ecf\\u52a0\\u5165\\u6e38\\u620f!';\\n      } catch (err) {\\n        return err.message;\\n      }\\n    });\\n\\n  ctx.command('murder-mystery.start', '\\u5f00\\u59cb\\u6e38\\u620f')\\n    .channelFields(['murder-mystery.sessionId'])\\n    .action(({ session }) => {\\n      const game = getSession(session.channel['murder-mystery.sessionId']);\\n      try {\\n        game.start();\\n        return '\\u6e38\\u620f\\u5f00\\u59cb!';\\n      } catch (err) {\\n        return err.message;\\n      }\\n    });\\n\\n  ctx.command('murder-mystery.status', '\\u67e5\\u770b\\u6e38\\u620f\\u72b6\\u6001')\\n  .channelFields(['murder-mystery.sessionId'])\\n  .action(({ session }) => {\\n    const game = getSession(session.channel['murder-mystery.sessionId']);\\n    return game.getStatus();\\n  });\\n  \\n  ctx.command('murder-mystery.send', '\\u53d1\\u9001\\u6d88\\u606f')\\n  .channelFields(['murder-mystery.sessionId'])\\n  .option('message', '-m <message>  \\u8981\\u53d1\\u9001\\u7684\\u6d88\\u606f')\\n  .action(({ session, options }) => {\\n      const game = getSession(session.channel['murder-mystery.sessionId']);\\n      try {\\n        game.sendMessage(session.userId, options.message);\\n        return '\\u4f60\\u7684\\u6d88\\u606f\\u5df2\\u7ecf\\u53d1\\u9001!';\\n      } catch (err) {\\n        return err.message;\\n      }\\n    });\\n  \\n\\n  ctx.command('murder-mystery.vote', '\\u6295\\u7968')\\n    .channelFields(['murder-mystery.sessionId'])\\n    .option('suspect', '-s <id>  \\u5acc\\u7591\\u4eba\\u7684 id')\\n    .action(({ session, options }) => {\\n      const game = getSession(session.channel['murder-mystery.sessionId']);\\n      try {\\n        game.vote(session.userId, options.suspect);\\n        return '\\u4f60\\u7684\\u6295\\u7968\\u5df2\\u7ecf\\u8bb0\\u5f55!';\\n      } catch (err) {\\n        return err.message;\\n      }\\n    });\\n\\n  }\\n);""",ERROR: 400
"""Can you describe the color blue?"," Below your answer, provide at least three uses of the color blue in your own words and explain why these are effective.

Blue is a vibrant and eye-catching color.""

Three effective uses of blue in brand design:
1. Science and medical fields: Blue is often used in healthcare logos and packaging to convey trust, reliability, and professionalism, making patients feel secure.
2. Baby products: Blue is popular in nursery decor and детский товар (children's products) as it's associated with calmness, creativity, and nurturing, creating a peaceful atmosphere for infants.
3. Technology companies: Many tech firms incorporate blue in their designs to project a sense of innovation, Progress, and stability, appealing to consumers who value these qualities in their products.

These blue applications are effective because they align with common associations and values, helping brands connect with their target audiences on an emotional level."
"""What is a dove?"," A dove is a small bird, typically found in various habitats. Doves are known for their peaceful nature, beautifully rounded bodies, short strong beaks that are perfect for cracking seeds, and their distinctive cooing calls. Most dove species have kept their shape little changed for millions of years, making them a stark contrast to many other bird families. While most doves parentheses timezonely outlined by the sky in their natural habitat, there is one apartment complex where a dove is found in the air. In general, doves are belonged to the family Columbidae, which includes both rock doves and passenger pigeons. Interestingly, the Maori people of New Zealand are thought to have brought pairs of rock doves in 1402, though they did not thrive in the new environment."""
"""If a tree falls in a forest, and there\\u2019s no one around to hear it, does it make a sound?","]

If a tree falls in a forest and there's no one around to hear it, it doesn't make a sound. sound waves need a medium to travel through, and in this case, there are no ears present to detect the sound.""

