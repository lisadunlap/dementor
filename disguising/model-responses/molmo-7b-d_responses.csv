SELECT s.* FROM students s
INNER JOIN advisors a ON s.advisor_id = a.id
WHERE s.gender = ' female' AND
s.program IN ('Computer Science', 'Mathematics', 'Physics', 'Chemistry', 'Biology', 'Economics', 'Environmental Science')
AND s.admission_date < DATE_SUB(current_date, INTERVAL 3 YEAR)"
