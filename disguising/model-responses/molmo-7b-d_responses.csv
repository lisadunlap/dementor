        < input type=""text"" name="" MACHINE_NAME"" onChange={handleChange} />
        < br />
        < label htmlFor="" MACHINE serial number""> MACHINE serial number</ label>
        < input type=""text"" name="" MACHINE serial number"" onChange={handleChange} />
        < br />
        < buttons className=""App buttons"">
