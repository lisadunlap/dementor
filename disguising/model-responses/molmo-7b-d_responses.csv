"""Give scores to my code.\\nReadability.\\nQuality.\\nAccording to best practices.\\nEasy to debug.\\nEasy to expand.\\nFrom 0 to 10.\\n\\nimport json\\nimport os\\nimport random\\nfrom enum import Enum\\n\\nclass FitnessPreference(Enum):\\n    HIGHER_IS_BETTER = True\\n    LOWER_IS_BETTER = False\\n\\nclass Evolution:\\n    CHANCE_OF_SECOND_MUTATION_PER_VALUE = 0.1\\n\\n    def __init__(\\n        self,\\n        first_gene,\\n        fitness_function,\\n        genes_amount=2,\\n        fitness_preference=FitnessPreference.HIGHER_IS_BETTER,\\n        save_after_num_cycles=100,\\n        start_from_save=False,\\n    ):\\n        self.genes = []\\n        self.fitness_values = []\\n        \\n        if start_from_save:\\n            self.from_save_of_first_gene(first_gene)\\n        else:\\n            self.set_first_gene(first_gene)\\n\\n        self.fitness_function = fitness_function\\n        self.genes_amount = genes_amount\\n        self.fitness_preference = fitness_preference\\n        self.save_after_num_cycles = save_after_num_cycles\\n\\n        self.savefile_name = \\""genes.json\\""\\n        self.desktop_path = r\\""C:\\\\Users\\\\romah\\\\OneDrive\\\\\\u0420\\u043e\\u0431\\u043e\\u0447\\u0438\\u0439 \\u0441\\u0442\\u0456\\u043b\\""\\n        self.filename_with_path = os.path.join(self.desktop_path, self.savefile_name)\\n\\n        \\n\\n    def run_for_cycles(self, num_of_cycles):\\n        for i in range(0, num_of_cycles):\\n            if i % self.save_after_num_cycles == 0:\\n                self.write_json_savepoint((self.genes, self.fitness_values))\\n                print((self.genes, self.fitness_values))\\n\\n            self.populate(self.best_one_populate_everything)\\n\\n            self.calculate_fitness_for_genes()\\n\\n            self.delete_bad_genes()\\n\\n    def set_first_gene(self, gene):\\n        self.genes = [gene]\\n        self.fitness_values = [0]\\n\\n    def from_save_of_first_gene(self, gene):\\n        data = self.read_json_savepoint()\\n\\n        if data is None:\\n            self.set_first_gene(gene)\\n        else:\\n            self.genes, self.fitness_values = data\\n\\n    def set_fitness_preference(self, preference):\\n        self.fitness_preference = preference\\n\\n    def set_fitness_function(self, fitness_function):\\n        self.fitness_function = fitness_function\\n\\n    def set_genes_amount(self, genes_amount):\\n        self.genes_amount = genes_amount\\n\\n    def create_gene_from(self, source_gene):\\n        self.genes.append(source_gene.copy())\\n        self.fitness_values.append(-1)\\n\\n    def best_one_populate_everything(self):\\n        if len(self.genes) > 1:\\n            self.leave_only_best_one()\\n\\n        mutation_rate_per_gene = self.CHANCE_OF_SECOND_MUTATION_PER_VALUE * len(\\n            self.genes[0]\\n        )\\n\\n        for i in range(1, self.genes_amount):\\n            is_mutated_once = False\\n            is_mutated = False\\n\\n            self.create_gene_from(self.genes[0])\\n\\n            while is_mutated or not is_mutated_once:\\n                is_mutated = False\\n                chance_of_second_mutation = random.random()\\n\\n                if (\\n                    not is_mutated_once\\n                    or chance_of_second_mutation <= mutation_rate_per_gene\\n                ):\\n                    self.mutate_gene_gaussian(self.genes[i])\\n                    is_mutated = True\\n                    is_mutated_once = True\\n\\n    def mutate_gene_gaussian(self, gene):\\n        mutation_location = random.randint(0, len(gene) - 1)\\n\\n        gene[mutation_location] = gene[mutation_location] * random.gauss(\\n            1, 0.01\\n        ) + random.gauss(0, 0.01)\\n\\n    def mutate_gene_swap(self, gene):\\n        pass\\n\\n    def leave_only_best_one(self):\\n        best_gene, best_fitness = self.get_best_gene()\\n        self.genes, self.fitness_values = [best_gene], [best_fitness]\\n\\n    def populate(self, population_method):\\n        population_method()\\n\\n    def calculate_fitness_for_genes(self):\\n        for i, gene in enumerate(self.genes):\\n            self.fitness_values[i] = self.fitness_function(gene)\\n\\n    def delete_bad_genes(self):\\n        self.leave_only_best_one()\\n\\n    def get_best_gene(self):\\n        gene_fitness_pairs = zip(self.genes, self.fitness_values)\\n\\n        sorted_pairs = sorted(\\n            gene_fitness_pairs,\\n            key=lambda x: x[1],\\n            reverse=self.fitness_preference.value,\\n        )\\n\\n        return sorted_pairs[0]\\n\\n    def read_json_savepoint(self):\\n        try:\\n            with open(self.filename_with_path, \\""r\\"") as file:\\n                print(\\""Data loaded successfully!\\"")\\n                return json.load(file)\\n\\n        except FileNotFoundError:\\n            print(f\\""The file {self.filename_with_path} does not exist during reading.\\"")\\n            return None\\n        except json.JSONDecodeError as e:\\n            print(f\\""Error decoding JSON data: {e}\\"")\\n            return None\\n        except Exception as e:\\n            print(f\\""Error loading data: {e}\\"")\\n\\n    def write_json_savepoint(self, data):\\n        try:\\n            with open(self.filename_with_path, \\""w\\"") as file:\\n                json.dump(data, file)\\n            # print(f\\""Data saved to {filename}\\"")\\n        except Exception as e:\\n            print(f\\""Error saving data: {e}\\"")\\n\\n\\n# Numeric version first\\nif __name__ == \\""__main__\\"":\\n\\n    def user_defined_fitness_function(gene):\\n        error = 0\\n\\n        error += (6 - (gene[0] + gene[1] + gene[2])) ** 2\\n        error += (2 - (gene[0] - gene[1] + gene[2])) ** 2\\n        error += (-1 - (gene[0] - gene[1])) ** 2\\n\\n        return error\\n\\n    evolution = Evolution(\\n        first_gene=[1, 1, 1],\\n        genes_amount=2,\\n        fitness_function=user_defined_fitness_function,\\n        fitness_preference=FitnessPreference.LOWER_IS_BETTER,\\n        save_after_num_cycles=100,\\n        start_from_save=False,\\n    )\\n\\n    evolution.run_for_cycles(1000)\\n\\n    print(evolution.get_best_gene())""",
