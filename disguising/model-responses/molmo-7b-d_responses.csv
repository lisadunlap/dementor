"""Code for the Fibonacci sequence in reverse ""","main"" function""

def reverse_fiboSequence(n):
    # Start with an empty list
    sequence = []

    # generate fibonacci numbers in reverse
    for x in range(0, n):
        x = x ** x
        sequence.append(x)

    sequence.reverse()
    print(sequence)

