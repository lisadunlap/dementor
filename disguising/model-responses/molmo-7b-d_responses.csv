"""Implement producer and consumer pattern in Python using threads."""," The code should include a producer thread that repeatedly creates and queue new messages and a consumer thread that reads and prints messages from the queue. Use blocking queues for thread communication and implement rate limiting to prevent the producer from creating new messages faster than the consumer can print them.Customize the messages for variety and add appropriate exception handling. Aim for around 50 lines of code, not including comments or built-in functions.
```python
import queue
import threading
import time
import random

# message queue
msg_queue = queue.Queue(maxsize=10)

# producer thread
def producer():
    while True:
        # sleep to prevent over-producing
        time.sleep(random.randint(1, 3))

        # get a unique message
        msg = f""Message {random.randint(0, 100)}""

        # add message to queue
        try:
            msg_queue.put(msg, block=False)
        except queue.Full:
            print(""Producer thread full, message dropped"")

# consumer thread
def consumer():
    while True:
        # sleep to prevent over-consuming
        time.sleep(random.randint(0, 2))

        # get and print message
        try:
            msg = msg_queue.get(block=True)
        except queue.Empty:
            print(""Consumer thread empty, waiting"")
        else:
            print(msg)

# create and start threads
producer_thread = threading.Thread(target=producer).start()
consumer_thread = threading.Thread(target=consumer).start()
```"
