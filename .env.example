# =============================================================================
# Dementor environment — copy to `.env` (git-ignored) and edit for THIS box.
# Every var has a sane default (our shared H100 box's values), so an unset var
# reproduces our-box behaviour. A partner on a different box overrides the paths
# + GPU pool below; nothing else is machine-specific.
# =============================================================================

# --- Canonical vars (shared verbatim by the steering + imitation packages) ---
# Repo root. Auto-detected from each script's location; set only if you relocate scripts.
# DEMENTOR_REPO=/path/to/dementor

# Local model-weights root. load_worklist() repoints a roster entry to
# $DEMENTOR_MODELS_DIR/<slug> when its literal (our-box) path is absent — so name each
# model's snapshot dir after its worklist slug (e.g. .../nemotron-super-120b).
DEMENTOR_MODELS_DIR=/data/ethantsliu/models_dl

# HuggingFace cache root (big disk recommended). Judges/graders + local snapshots live here.
DEMENTOR_HF_HOME=/data/ethantsliu/huggingface

# Big-disk data/outputs root (default: the repo's data/ dir).
DEMENTOR_DATA=/data/ethantsliu

# GPU ids this box may use, comma-separated. Our box: 5,6,7 (GPU4 banned, 0-3 belong to others).
# A dedicated 4-card box: DEMENTOR_GPUS=0,1,2,3
DEMENTOR_GPUS=5,6,7

# --- Steering-specific roots (default to our-box paths; override on a partner box) ---
# Steering experiment tree (holds judge_all.py + benchmarks/) consumed by cone_eval.py.
# DEMENTOR_STEER_ROOT=/data/ethantsliu/exp_steer_safety
# Per-model <slug>/ outputs + the run copy of rdo_worklist.json. A partner points this at
# their own scratch dir; when it lacks rdo_worklist.json the committed repo copy is used.
# DEMENTOR_STEER_WORK=/path/to/scratch/repl80_rdo
# SaladBench harmful/harmless splits used for cone training + dim selection.
# DEMENTOR_SALADBENCH_SPLITS=/data/ethantsliu/geometry-of-refusal/data/saladbench_splits
# RTL harm-judge infra dir (rtl_judge.py). Defaults to the in-repo experiments/steering/port.
# DEMENTOR_RTL_JUDGE_DIR=/data/ethantsliu/exp3_safety/leak_fix
# Python interpreter for subprocess relaunches (default: the running interpreter).
# DEMENTOR_PY=/data/ethantsliu/venvs/dementor-ethan/bin/python

# --- Credentials (required for gated judges / graders / Tinker sampling) ---
HF_TOKEN=hf_xxx                 # gated judge/base models (meta-llama/Llama-Guard-3-8B)
OPENAI_API_KEY=sk-xxx           # dormant OpenAI grader cross-checks + prompt-rung analyzer
OPENAI_BASE_URL=                # optional: custom OpenAI-compatible endpoint
TINKER_API_KEY=                 # imitation track only: sample the Tinker adapters
